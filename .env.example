# AutoResearch — Environment Variables

# ── Required ──────────────────────────────────────────────────────────────────
# OpenAI API key for all LLM calls (planner, extractor, critic, synthesizer)
OPENAI_API_KEY=sk-...

# ── Optional: Search ──────────────────────────────────────────────────────────
# Tavily provides higher-quality web search results.
# If omitted, falls back to free DuckDuckGo search.
TAVILY_API_KEY=tvly-...

# ── Optional: LLM tuning ──────────────────────────────────────────────────────
# Primary model for complex reasoning (planner, critic, synthesizer)
MODEL_NAME=gpt-4o

# Faster/cheaper model for high-volume extraction
FAST_MODEL_NAME=gpt-4o-mini

TEMPERATURE=0.1
MAX_TOKENS=4096

# ── Optional: Research behaviour ─────────────────────────────────────────────
MAX_RESEARCH_ITERATIONS=3
MAX_WEB_RESULTS=5
MAX_ACADEMIC_RESULTS=5

# ── Optional: Storage ─────────────────────────────────────────────────────────
# Where ChromaDB persists long-term research memory
CHROMA_PERSIST_DIR=./data/chroma_db
