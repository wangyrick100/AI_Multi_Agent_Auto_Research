# AutoResearch environment variables

# ── Required ──────────────────────────────────────────────────────────────────
# Required
# OpenAI API key used by the planner, extractor, critic, and synthesizer.
OPENAI_API_KEY=sk-...

# ── Optional: Search ──────────────────────────────────────────────────────────
# Optional search configuration
# Tavily improves web retrieval quality. If omitted, the backend falls back to
# DuckDuckGo search.
TAVILY_API_KEY=tvly-...

# ── Optional: LLM tuning ──────────────────────────────────────────────────────
# Optional model configuration
# Primary reasoning model used for planning, critique, and synthesis.
MODEL_NAME=gpt-4o

# Faster model used for high-volume extraction.
FAST_MODEL_NAME=gpt-4o-mini

TEMPERATURE=0.1
MAX_TOKENS=4096

# ── Optional: Research behaviour ─────────────────────────────────────────────
# Optional research behavior
MAX_RESEARCH_ITERATIONS=3
MAX_WEB_RESULTS=5
MAX_ACADEMIC_RESULTS=5

# ── Optional: Storage ─────────────────────────────────────────────────────────
# Optional storage
# Local ChromaDB persistence directory for long-term memory.
CHROMA_PERSIST_DIR=./data/chroma_db
